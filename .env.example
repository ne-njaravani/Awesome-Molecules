# Configure these as hosted Worker secrets/environment values, never commit real keys.
# API_ENABLED is deliberately false until the owner has configured a provider and budget.
API_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional model IDs. Validate availability in your provider account first.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat

# One-request guardrails. These are not a total monthly spending limit.
MAX_OUTPUT_TOKENS=512
MAX_REQUEST_ESTIMATED_USD=0.05

# Optional costs in USD per 1 million tokens. Update from current provider rates.
# When unset, actual token usage is still reported but dollar spend is N/A.
OPENAI_INPUT_USD_PER_M=
OPENAI_OUTPUT_USD_PER_M=
ANTHROPIC_INPUT_USD_PER_M=
ANTHROPIC_OUTPUT_USD_PER_M=
GEMINI_INPUT_USD_PER_M=
GEMINI_OUTPUT_USD_PER_M=
DEEPSEEK_INPUT_USD_PER_M=
DEEPSEEK_OUTPUT_USD_PER_M=
